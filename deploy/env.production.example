# POLAR WINDOW: the .env for the public site (https://polarwindow.ahbab.tech).
#
# Copy to the repository root on the VM as .env (docs/deploy-gcp.md, stage 5):
#   cp deploy/env.production.example .env && chmod 600 .env
# Placeholders only. Every line with CHANGE_ME must be replaced before the first
# start; `grep -n CHANGE_ME .env` must print nothing. Two are made on the VM with
# openssl (the runbook's commands write them without printing them); the owner types
# the API keys in by hand. Never paste this file, filled in, into a chat or a commit.
#
# docker-compose.yml reads the COMPOSE_* and the PW_BIND/WEB/DB/FORWARDED lines for
# itself; every service also gets the whole file as its environment, and the backend
# reads the PW_ names (backend/app/config.py) and ignores the rest. The database URL,
# the Redis URL and the data folder are set by docker-compose.yml, not here.

# --- docker compose -------------------------------------------------------------
# One project name for `docker compose` and run_onVM.py alike, so both find the same
# containers and the same database volume (polar-window_pgdata).
COMPOSE_PROJECT_NAME=polar-window
# Build and start the dashboard (`web`) with the rest.
COMPOSE_PROFILES=web
# The database, the cache and the api: this machine only.
PW_BIND_ADDR=127.0.0.1
# The dashboard: this machine only, on 8080. The host's nginx serves 80 and 443.
PW_WEB_ADDR=127.0.0.1
PW_WEB_PORT=8080
# The api believes X-Forwarded-For from any peer. Safe here: port 8000 is reachable
# from this machine only, and the host's nginx sets the header to the visitor's
# address itself. Without it every visitor shares one rate-limit allowance.
PW_FORWARDED_ALLOW_IPS=*
# The database password. Hex only (it goes into a URL). Used when the pgdata volume
# is first created; changing it later does not change the database's password.
PW_DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- service ----------------------------------------------------------------------
# prod refuses to start without PW_JWT_SECRET (config.py, _check_prod_secrets).
PW_ENV=prod
PW_LOG_LEVEL=INFO
PW_API_PREFIX=/api/v1
PW_OFFLINE=false
# The pages and the api share one origin, so the browser sends no CORS request.
# The site's own origin only; no localhost.
PW_CORS_ORIGINS=https://polarwindow.ahbab.tech
PW_DOWNLOAD_KERNELS_ON_START=false
PW_REDIS_ENABLED=true
# 0: one SPICE thread in the api (the default). 2 or more only on 4 vCPUs or more.
PW_SPICE_WORKERS=0

# --- sign-in --------------------------------------------------------------------
# Signs session tokens. 96 hex characters, made on the VM; keep it the same across
# restarts so sessions survive them.
PW_JWT_SECRET=CHANGE_ME_JWT_SECRET
PW_JWT_TTL_S=43200
# The front page's one-click sign-in. The judged site needs it: true.
PW_DEMO_SIGN_IN=true

# --- limits (per visitor address, per minute; reads are never limited here) -------
PW_RATE_LIMITS=true
# A named sign-in makes a user row; a person signs in once per 12 h session.
PW_RATE_SIGN_IN_PER_MIN=10
# Each Ask spends the owner's Gemini quota (up to PW_AGENT_MAX_ROUNDS model calls).
PW_RATE_AGENTS_PER_MIN=10
# Compare and the power, landing-ellipse and mesh runs move with sliders: defaults.
PW_RATE_COMPARE_PER_MIN=60
PW_RATE_ENERGY_PER_MIN=60
# Every other change, including reading a project file and reading a scenario
# prompt (both call the model) and starting a scenario (queues a job).
PW_RATE_WRITES_PER_MIN=30
# Jobs waiting for the one compute worker; past this a new one answers 503 with
# Retry-After 60. Stored answers are always served.
PW_MAX_QUEUED_JOBS=60
PW_MAX_BODY_BYTES=65536
PW_MAX_UPLOAD_BYTES=8388608

# --- data providers ---------------------------------------------------------------
# api.nasa.gov key (free). DEMO_KEY allows 30 requests an hour; the feeds worker's
# space-weather fetches share it. Put DEMO_KEY back only if there is no key.
PW_NASA_API_KEY=CHANGE_ME_NASA_API_KEY
# Only for the bulk GHRC archives, which this site does not fetch.
PW_EARTHDATA_TOKEN=
PW_DATA_CONTACT=https://github.com/MdAhbab/PolarWindow

# --- agents -----------------------------------------------------------------------
# The owner's key, typed in by hand. Leave blank to run every AI panel from the
# measurements only.
PW_GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
# Models that answer on this key, first (docs/handoff.md section 3: 3.6-flash,
# 3.5-flash and 3.5-flash-lite answer in 3 to 5 s; 3.8-flash and 3.7-flash accept a
# request and stay silent, so they are left out). Or copy these two lines from the
# PC's .env by hand.
PW_AGENT_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash,gemini-2.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
PW_AGENT_MODELS_LIGHT=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash
PW_AGENT_TIMEOUT_S=20
PW_AGENT_ATTEMPT_TIMEOUT_S=8
PW_AGENT_MAX_ROUNDS=4
PW_AGENT_MAX_TOOL_CALLS=8
PW_AGENT_MAX_OUTPUT_TOKENS=4096
