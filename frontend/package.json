{
  "name": "polar-window",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing site planning for the Moon's south pole. NASA Space Apps 2026 \u2014 CLPS Lunar Mission Browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check": "tsc -b --noEmit",
    "codegen": "openapi-typescript ../docs/openapi.json -o src/lib/api/schema.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "openapi-typescript": "^7.5.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  }
}
