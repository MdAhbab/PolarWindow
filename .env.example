# POLAR WINDOW — every environment variable the backend reads.
#
# All of them are typed in backend/app/config.py, which is the only place in
# the codebase that touches os.environ. If a name is not here, nothing reads it.
# Copy to .env and edit; every value below is the built-in default.

# --- service ---------------------------------------------------------------
PW_ENV=dev
PW_LOG_LEVEL=INFO
PW_API_PREFIX=/api/v1

# Demo mode with no network: the model is never called (agents answer from
# measurements), kernel and DEM downloads are refused, and responses say so.
# The bare OFFLINE=1 from the build guide works too.
PW_OFFLINE=false

# Comma-separated. Vite takes the next free port when 5173 is busy, so both are
# listed by default — "works in curl, fails in the browser" is always this.
PW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173

# --- data on disk ----------------------------------------------------------
# Kernels, the DEM subset and the tile pyramid all live under here.
PW_DATA_DIR=./data

# Download SPICE kernels at startup if missing. Off by default: a container
# that silently pulls 114 MB at boot turns a fast, obvious failure into a slow
# mystery. `make kernels` fetches them; the API only checks.
PW_DOWNLOAD_KERNELS_ON_START=false

# --- stores ----------------------------------------------------------------
PW_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/polar_window
PW_REDIS_URL=redis://localhost:6379/0
PW_REDIS_ENABLED=true

# --- compute ---------------------------------------------------------------
# 900 s over a 708 h window is 2,835 samples per body. See ADR-1 for why.
PW_DEFAULT_STEP_S=900
PW_MIN_STEP_S=300
PW_MAX_STEP_S=7200
PW_MAX_WINDOW_DAYS=730

# 0.25 deg = 1440 rays. One bin is ~29 minutes of the Sun's azimuth sweep at
# the pole, which is just under the timing uncertainty the DEM error implies.
PW_AZIMUTH_STEP_DEG=0.25
PW_MAX_RANGE_M=50000
PW_FINE_DEM_RADIUS_M=20000

# --- cache -----------------------------------------------------------------
# Computed windows kept in-process so /timeline, /windows and /metrics for one
# window share one geometry run. About 0.3 MB each.
PW_GEOMETRY_MEMO_ENTRIES=32
PW_CACHE_TTL_TIMELINE_S=3600
PW_CACHE_TTL_WINDOWS_S=86400
PW_CACHE_TTL_METRICS_S=86400

# --- data providers ----------------------------------------------------------
# Free keys. Everything works without them; a missing key skips that source
# and the app says which one. See README "Required data".
# NASA Earthdata Login token (urs.earthdata.nasa.gov): bulk GHRC archives only.
PW_EARTHDATA_TOKEN=
# api.nasa.gov key: space weather events (DONKI). DEMO_KEY allows 30 an hour.
PW_NASA_API_KEY=DEMO_KEY
# Shown to data providers in the User-Agent header.
PW_DATA_CONTACT=https://github.com/MdAhbab/PolarWindow

# --- sign-in ---------------------------------------------------------------
# Signs the session tokens (HS256). Blank: a random secret per process, so a
# restart ends every session and the dashboard signs in again by itself. Set
# it wherever more than one process serves the API.
PW_JWT_SECRET=
PW_JWT_TTL_S=43200
# The front page's one-click sign-in as the project manager, with no password.
# Right for a judged demo; set false anywhere real.
PW_DEMO_SIGN_IN=true

# --- agents ----------------------------------------------------------------
# Leave blank and the agents degrade to deterministic summaries built from the
# same tool results. The four key numbers never depend on this being set.
PW_GEMINI_API_KEY=
# Models to try, in order: a run moves to the next when one is over its quota,
# not served to the key, or down, and skips it until its quota resets.
PW_AGENT_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# The Explainer writes one paragraph from given facts; lightest first.
PW_AGENT_MODELS_LIGHT=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash
PW_AGENT_TIMEOUT_S=20
PW_AGENT_MAX_ROUNDS=4
PW_AGENT_MAX_TOOL_CALLS=8
PW_AGENT_MAX_OUTPUT_TOKENS=2048
# Unset keeps the model's default temperature, which Gemini 3 is tuned for.
# PW_AGENT_TEMPERATURE=
