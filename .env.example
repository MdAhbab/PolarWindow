# POLAR WINDOW — every environment variable the backend reads.
#
# All of them are typed in backend/app/config.py, which is the only place in
# the codebase that touches os.environ. If a name is not here, nothing reads it.
# Copy to .env and edit; every value below is the built-in default.

# --- service ---------------------------------------------------------------
PW_ENV=dev
PW_LOG_LEVEL=INFO
PW_API_PREFIX=/api/v1

# Comma-separated. Vite takes the next free port when 5173 is busy, so both are
# listed by default — "works in curl, fails in the browser" is always this.
PW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:4173

# --- data on disk ----------------------------------------------------------
# Kernels, the DEM subset and the tile pyramid all live under here.
PW_DATA_DIR=./data

# Download SPICE kernels at startup if missing. Off by default: a container
# that silently pulls 114 MB at boot turns a fast, obvious failure into a slow
# mystery. `make kernels` fetches them; the API only checks.
PW_DOWNLOAD_KERNELS_ON_START=false

# --- stores ----------------------------------------------------------------
PW_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/polar_window
PW_REDIS_URL=redis://localhost:6379/0
PW_REDIS_ENABLED=true

# --- compute ---------------------------------------------------------------
# 900 s over a 708 h window is 2,835 samples per body. See ADR-1 for why.
PW_DEFAULT_STEP_S=900
PW_MIN_STEP_S=300
PW_MAX_STEP_S=7200
PW_MAX_WINDOW_DAYS=730

# 0.25 deg = 1440 rays. One bin is ~29 minutes of the Sun's azimuth sweep at
# the pole, which is just under the timing uncertainty the DEM error implies.
PW_AZIMUTH_STEP_DEG=0.25
PW_MAX_RANGE_M=50000
PW_FINE_DEM_RADIUS_M=20000

# --- cache -----------------------------------------------------------------
PW_CACHE_TTL_TIMELINE_S=3600
PW_CACHE_TTL_WINDOWS_S=86400
PW_CACHE_TTL_METRICS_S=86400

# --- agents ----------------------------------------------------------------
# Leave blank and the agents degrade to deterministic summaries built from the
# same tool results. The four key numbers never depend on this being set.
PW_GEMINI_API_KEY=
PW_AGENT_MODEL=gemini-3.8-flash
PW_AGENT_MODEL_LIGHT=gemini-3.5-flash-lite
PW_AGENT_TIMEOUT_S=20
PW_AGENT_MAX_ROUNDS=4
PW_AGENT_MAX_TOOL_CALLS=8
